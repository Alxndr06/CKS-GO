Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Seuls le point d'entrée et les fichiers publics doivent être servis directement.
    RewriteRule ^(?:index\.php)?$ - [L]
    RewriteRule ^public/ - [L]
    RewriteRule ^ - [R=404,L]
</IfModule>

<FilesMatch "(?i)^(?:\.env|composer\.(?:json|lock)|.*\.(?:sql|log|ini|bak))$">
    Require all denied
</FilesMatch>
